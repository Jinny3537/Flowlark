{
  "name": "flowlark",
  "version": "0.7.0",
  "description": "Flowlark — Where prototypes flow。本地原型版本库：CLI 管数据，浏览器看原型，数据是纯文本文件直接进 Git",
  "type": "module",
  "license": "MIT",
  "author": "flowlark contributors",
  "homepage": "https://github.com/Jinny3537/Flowlark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jinny3537/Flowlark.git"
  },
  "bugs": {
    "url": "https://github.com/Jinny3537/Flowlark/issues"
  },
  "bin": {
    "flowlark": "bin/flowlark.js",
    "fl": "bin/flowlark.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin/",
    "src/",
    "web/dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "test": "node --test",
    "build:web": "cd web && npm install && npm run build",
    "start": "bash ./start.sh",
    "serve": "node bin/flowlark.js serve",
    "prepublishOnly": "npm run build:web && npm test"
  },
  "keywords": [
    "prototype",
    "version-control",
    "html",
    "local-first",
    "cli",
    "git",
    "原型",
    "版本管理"
  ],
  "dependencies": {}
}
